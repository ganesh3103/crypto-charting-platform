# Market data provider (Phase 1 hits Binance's public REST/WS endpoints
# directly from the browser — no key required for market data).
# These are placeholders for swapping in a different provider later, or for
# routing through your own backend proxy.
VITE_MARKET_DATA_API_URL=https://api.binance.com/api/v3
VITE_MARKET_WS_URL=wss://stream.binance.com:9443/ws

# If a future provider requires a secret API key, it must live on a backend
# service, never in a VITE_* variable (those are bundled into client JS).
